# Copiá este archivo a .env.local y completá los valores.
# .env.local NO se sube a git (ver .gitignore).

# Supabase (Project Settings > API en el dashboard de Supabase)
# OJO: es la URL base del proyecto, SIN /rest/v1/ al final (supabase-js lo agrega solo).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...
# Service role: solo se usa en el servidor (webhook de Mercado Pago, acciones admin).
# NUNCA exponer con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# Mercado Pago (Tus integraciones > credenciales de producción, en
# https://www.mercadopago.com.ar/developers/panel). Con esto vacío, el botón
# de "Pagar con Mercado Pago" no aparece y solo se puede reservar en efectivo.
MERCADOPAGO_ACCESS_TOKEN=
# Localhost sirve para probar la creación de la preferencia y que redirija a
# Mercado Pago, pero el webhook (que confirma el pago y crea el turno) NO
# puede llegar a tu máquina — Mercado Pago necesita una URL pública. Una vez
# desplegado en Vercel, poné acá la URL real (https://tu-proyecto.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp del peluquero por defecto (formato E.164 sin "+"), fallback
# si un peluquero no tiene teléfono cargado.
NEXT_PUBLIC_WHATSAPP_DEFAULT=5491100000000
